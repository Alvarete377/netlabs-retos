#!/bin/bash
# Ejecuta una orden dentro de la máquina virtual por SSH (sin argumentos: shell interactiva).
# La entrada estándar pasa tal cual, así que `vmexec sh -s < script` funciona.
ssh=(ssh -q -i /vm/key -p 2222 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null
     -o ConnectTimeout=5 -o LogLevel=ERROR -o BatchMode=yes root@127.0.0.1)
if [ $# -eq 0 ]; then
  exec "${ssh[@]}" -t
fi
exec "${ssh[@]}" -- "$(printf '%q ' "$@")"
