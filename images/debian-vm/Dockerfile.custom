# Herramientas para preparar el disco de netlabs/debian-vm sin arrancarlo (libguestfs / virt-customize).
FROM debian:12-slim
ENV DEBIAN_FRONTEND=noninteractive LIBGUESTFS_BACKEND=direct
RUN apt-get update && apt-get install -y --no-install-recommends \
      libguestfs-tools linux-image-amd64 qemu-utils openssh-client ca-certificates \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
