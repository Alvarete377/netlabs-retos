#!/bin/sh
# Carga las imágenes precargadas y les da su nombre de Docker Hub, para que `podman run nginx:...`
# las encuentre en local y no intente descargarlas.
set -e
podman load -q -i /opt/netlabs/imagenes.tar >/dev/null
for i in alpine:3.20 nginx:1.27-alpine; do
  podman tag "localhost/$i" "docker.io/library/$i"
  podman rmi "localhost/$i" >/dev/null
done
