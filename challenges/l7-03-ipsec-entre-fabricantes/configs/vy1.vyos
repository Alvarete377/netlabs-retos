set system host-name vy1
set interfaces ethernet eth1 address 203.0.113.2/30
set interfaces ethernet eth1 description 'WAN de la filial'
set interfaces ethernet eth2 address 192.168.2.1/24
set interfaces ethernet eth2 description 'LAN de la filial'
set protocols static route 0.0.0.0/0 next-hop 203.0.113.1
set nat source rule 100 outbound-interface name eth1
set nat source rule 100 translation address masquerade
set nat source rule 100 description 'salida a Internet de la LAN'
