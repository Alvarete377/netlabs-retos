/system identity set name=hub
/ip address add address=192.168.0.1/24 interface=ether2 comment="LAN de la central"
/ip address add address=198.51.100.2/30 interface=ether3 comment="WAN de la central (IP publica)"
/ip route add dst-address=0.0.0.0/0 gateway=198.51.100.1 comment="salida a Internet"
/ip firewall nat add chain=srcnat out-interface=ether3 action=masquerade comment="salida a Internet de la LAN"
/interface wireguard add name=wg-sedes listen-port=51820 private-key="+BPTtsh9teOPC+t/QPisim5MQwClUQzTyW6GqwMBd2U=" comment="concentrador de las sedes"
/ip address add address=10.255.0.1/24 interface=wg-sedes comment="red de los tuneles"
/interface wireguard peers add interface=wg-sedes public-key="+hNnMYjbnqV+S/cablTSDdgUga1/9SjWyWrLX2t4E0U=" allowed-address=10.255.0.2/32,192.168.1.0/24 comment="sede 1"
/interface wireguard peers add interface=wg-sedes public-key="TNiAsU4X67ZmjtmXvD/PyZqltscEKDHlQg1GN4b+ezE=" allowed-address=10.255.0.3/32,192.168.20.0/24 comment="sede 2"
/ip route add dst-address=192.168.1.0/24 gateway=10.255.0.2 comment="LAN de la sede 1"
/ip route add dst-address=192.168.2.0/24 gateway=10.255.0.3 comment="LAN de la sede 2"
/ip firewall filter add chain=forward connection-state=established,related action=accept comment="respuestas"
/ip firewall filter add chain=forward connection-state=invalid action=drop comment="invalidos"
/ip firewall filter add chain=forward in-interface=ether2 action=accept comment="la LAN de la central sale a donde quiera"
/ip firewall filter add chain=forward in-interface=wg-sedes out-interface=ether2 action=accept comment="las sedes entran a la central"
/ip firewall filter add chain=forward action=drop comment="todo lo demas, fuera"
