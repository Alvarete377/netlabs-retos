set system host-name vy1
set interfaces ethernet eth1 address 172.16.12.2/30
set interfaces ethernet eth1 description 'enlace con la central (MikroTik)'
set interfaces ethernet eth2 address 192.168.2.1/24
set interfaces ethernet eth2 description 'LAN de la filial'
set protocols bgp system-as 65002
set protocols bgp parameters router-id 10.255.255.2
set protocols bgp neighbor 172.16.12.1 remote-as 65010
set protocols bgp neighbor 172.16.12.1 description 'central'
set protocols bgp neighbor 172.16.12.1 address-family ipv4-unicast
set protocols bgp address-family ipv4-unicast network 192.168.20.0/24
