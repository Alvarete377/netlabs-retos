/system identity set name=r1
/ipv6 nd set [find interface=all] ra-interval=10s-20s comment="LABORATORIO: anuncios cada 10-20 s para no esperar minutos"
/ipv6 address add address=2001:db8:f::2/64 interface=ether2 advertise=no comment="WAN"
/ipv6 route add dst-address=::/0 gateway=2001:db8:f::1 comment="salida a Internet"
/ipv6 dhcp-client add interface=ether2 request=address pool-name=isp-pd pool-prefix-length=64 add-default-route=no comment="pedir prefijo al operador"
/ipv6 address add address=::1/64 from-pool=pd interface=ether3 advertise=no comment="LAN de la oficina"
/ipv6 firewall filter add chain=input connection-state=established,related action=accept comment="respuestas"
/ipv6 firewall filter add chain=input protocol=icmpv6 action=accept comment="ICMPv6 (ND, errores, eco)"
/ipv6 firewall filter add chain=input in-interface=ether3 action=accept comment="la oficina gestiona r1"
/ipv6 firewall filter add chain=input action=drop comment="nada mas desde fuera"
/ipv6 firewall filter add chain=forward connection-state=established,related action=accept comment="respuestas"
/ipv6 firewall filter add chain=forward protocol=icmpv6 action=accept comment="ICMPv6"
/ipv6 firewall filter add chain=forward in-interface=ether3 action=accept comment="la oficina sale"
/ipv6 firewall filter add chain=forward action=drop comment="nada nuevo desde Internet"
